PORT=

# Browser origins allowed to call this gateway, comma-separated. Deploying is then an env change
# rather than a code change. No wildcard: the seller routes are authenticated, and a wildcard with
# credentials is both refused by browsers and wrong in principle.
# Production example: ALLOWED_ORIGINS=https://ramp402.vercel.app,https://www.ramp402.app
ALLOWED_ORIGINS=http://localhost:3000
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=
CONTRACT_ID=
OPERATOR_SECRET_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ANCHOR_HOME_DOMAIN=

# The fiat the off-ramp asks the anchor to quote. Defaults to TRY when unset. The anchor's SEP-38
# /info is still what decides: if it does not sell this currency, resolvePayoutAsset falls back to
# the first fiat it does sell, so a demo can pay out in the wrong currency without failing.
ANCHOR_PAYOUT_CURRENCY=TRY
PLATFORM_POOL_SECRET_KEY=
X402_FACILITATOR_URL=
TREASURY_ADDRESS=
UPSTREAM_CRED_ENCRYPTION_KEY=

# Where the SQLite cache file lives, relative to the gateway's working directory. Unset means
# ramp402.db there. On a host with an ephemeral filesystem (Railway, Fly, a plain container) that
# file is wiped on every deploy and restart: the chain keeps the balances, but the dashboard's
# endpoint and call history do not survive. To keep them, mount a volume and point DB_PATH inside
# it, e.g. DB_PATH=/data/ramp402.db.
DB_PATH=
