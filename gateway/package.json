{
  "name": "ramp402-gateway",
  "version": "0.1.0",
  "description": "Ramp402 gateway: x402 proxy, REST API, SQLite cache, anchor off-ramp",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "type": "module",
  "dependencies": {
    "@privy-io/node": "^0.34.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "@x402/core": "2.26.0",
    "@x402/express": "2.26.0",
    "@x402/stellar": "2.26.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
