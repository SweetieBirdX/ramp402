# Rename this file to .gitignore in the repo root.
# It must exist BEFORE the first commit — a secret committed once stays in the history.

# dependencies / build output
node_modules/
target/
dist/
.next/
out/

# local database (SQLite cache — the chain is the source of truth)
*.db
*.db-wal
*.db-shm

# secrets — never committed. The .example files ARE committed.
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Rust
**/*.rs.bk
# Cargo.lock IS committed for contract/ — the deployed wasm must be reproducible,
# and it pins ed25519-dalek 2.2.0 around a soroban-env-host 23.0.1 resolution break
# that otherwise breaks `cargo test` on a fresh clone.

# misc
*.log
coverage/
.turbo/