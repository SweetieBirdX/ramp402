# Root .env — read by the scripts in scripts/ only.
#
# The gateway has its own gateway/.env; the frontend has frontend/.env.local.
# This file exists so `npx tsx scripts/*.ts` can run without exporting variables
# by hand. Copy it to `.env` and fill it in. `.env` is gitignored — never commit
# a filled-in copy, and never put a secret key in THIS file.

# --- required -------------------------------------------------------------------------------

# The key baked into the deployed contract. scripts/setup.ts refuses to invent one:
# a fresh operator would make every record_call and settle fail with NotOperator.
OPERATOR_SECRET_KEY=

# --- optional: defaults are in scripts/lib/chain.ts -------------------------------------------

# Defaults to the contract in README.md's "## Contract" section.
CONTRACT_ID=
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# The anchor whose stellar.toml the USDC issuer is read from. Never hardcode an
# issuer: the mainnet one differs (CONVENTIONS.md §1.5).
ANCHOR_HOME_DOMAIN=

# Reused if set, generated and printed if not.
PLATFORM_POOL_SECRET_KEY=
# The treasury never signs — TreasuryTotal is a counter in the contract — so the
# address alone is enough. TREASURY_SECRET_KEY is only kept so the account is
# recoverable.
TREASURY_ADDRESS=
TREASURY_SECRET_KEY=

# --- demo fixtures --------------------------------------------------------------------------
# Not read by the gateway. Set them to get the same demo endpoint back after
# `npx tsx scripts/reset-demo.ts`, instead of a fresh one each time.

DEMO_SELLER_SECRET_KEY=
DEMO_PROXY_SLUG=
DEMO_UPSTREAM_URL=
DEMO_PRICE_STROOPS=

# Where the gateway keeps its SQLite cache, resolved relative to gateway/.
DB_PATH=
